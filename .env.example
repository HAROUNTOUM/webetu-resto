# ---------------------------------------------------------------------------
# Webetu / ONOU credentials (required)
# ---------------------------------------------------------------------------
# Matricule used to sign in to the Webetu app.
WEBETU_USERNAME=your-matricule
# Password of the Webetu app.
WEBETU_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Restaurant (optional)
# ---------------------------------------------------------------------------
# Leave empty to auto-detect when exactly one restaurant (isRu=1) is available.
# The setup wizard fills this for you.
WEBETU_RESTO_ID=

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# IANA timezone. Algeria is Africa/Algiers (UTC+1, no DST).
WEBETU_TIMEZONE=Africa/Algiers
# Daily booking time. 00:05 keeps tomorrow's breakfast more than 24h away.
WEBETU_RUN_AT=00:05
# Auto-check: re-run the idempotent pass every N minutes to fill gaps (0 = off).
WEBETU_CHECK_INTERVAL_MINUTES=60
# Rolling window: 1 = tomorrow, 2 = in two days, 3 = in three days.
WEBETU_BOOK_DAYS=1,2,3
# Meals: 1 = breakfast, 2 = lunch, 3 = dinner.
WEBETU_MEALS=1,2,3

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Docker sets this to /data/state.json (persisted volume).
WEBETU_STATE_PATH=./data/state.json
WEBETU_DRY_RUN=false
WEBETU_MAX_RETRIES=2
WEBETU_RETRY_DELAY=20
WEBETU_REQUEST_INTERVAL=0.3
WEBETU_LOG_LEVEL=INFO

# Also set TZ for the container/OS clock.
TZ=Africa/Algiers
